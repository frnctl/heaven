#!/usr/bin/env bash
# ✦ HEAVEN · Sync the universe. One word. Peace forever. ✦
set -Euo pipefail

VERSION="2.1.0-Omni"

# ─── OS Detection ───
OS_RAW=$(uname -s 2>/dev/null || echo "Unknown")
case "$OS_RAW" in
  Linux*)     OS="Linux" ;;
  Darwin*)    OS="macOS" ;;
  CYGWIN*|MINGW*|MSYS*|MINGW32*|Windows_NT*) OS="Windows" ;;
  *)          OS="Unknown ($OS_RAW)" ;;
esac

# ─── Environment Setup ───
BASE_DIR="${HEAVEN_BASE_DIR:-$HOME}"
GH_USER="${HEAVEN_GH_USER:-frnctl}"

if [ "$OS" = "Windows" ]; then
  TMP="${TEMP:-${TMP:-/tmp}}"
else
  TMP="${TMPDIR:-/tmp}"
fi
LOCKFILE="$TMP/heaven.lock"
PREVIEW=false

for arg in "$@"; do
  case "$arg" in
    --preview)  PREVIEW=true ;;
    --version)  echo "heaven v$VERSION ($OS)"; exit 0 ;;
    --help|-h)  echo "  heaven           sync all repos"; echo "  heaven --preview dry run"; exit 0 ;;
  esac
done

# ─── Oracle (AI integration) ───
USE_AI=true
if ! command -v gh >/dev/null 2>&1 || ! gh extension list 2>/dev/null | grep -q "gh-models"; then
  USE_AI=false
fi

oracle() {
  if ! $USE_AI; then echo ""; return; fi
  local sys="$1"
  local input="$2"
  local in_file="$TMP/heaven_oracle_in_$RANDOM"
  # Limit input size to prevent breaking the CLI or exceeding context windows
  echo "$input" | head -c 8000 > "$in_file"
  local res
  res=$(gh models run openai/gpt-4o-mini --system-prompt "$sys" "$(cat "$in_file")" 2>/dev/null || echo "")
  rm -f "$in_file"
  echo "$res"
}

# ─── Sensitive patterns (never committed) ───
SENSITIVE='\.env$|\.env\.|\.pem$|\.key$|\.p12$|\.pfx$|credentials|_secret|_SECRET|id_rsa|id_ed25519|id_ecdsa|\.netrc$|\.pypirc$|\.npmrc$|token\.json$|\.htpasswd$|kubeconfig|\.jks$|\.keystore$|\.ssh/'

# ─── Colors ───
W='\033[1;37m'; C='\033[1;36m'; G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; DIM='\033[2m'; D='\033[0m'

# ─── Clouds (rotating separators) ───
CLOUD_IDX=0
cloud() {
  local n=$(( CLOUD_IDX % 6 ))
  CLOUD_IDX=$(( CLOUD_IDX + 1 ))
  case $n in
    0) echo -e "${DIM}                              ☁    ·    ☁${D}" ;;
    1) echo -e "${DIM}                    ·    ☁         ·${D}" ;;
    2) echo -e "${DIM}                         ☁    ·         ☁${D}" ;;
    3) echo -e "${DIM}                              ·    ☁    ·${D}" ;;
    4) echo -e "${DIM}                    ☁              ☁${D}" ;;
    5) echo -e "${DIM}                         ·    ☁              ·${D}" ;;
  esac
}

# ─── Peaceful whispers (rotating) ───
PEACE_IDX=0
PEACE_MSGS=("sleeps well" "rests quietly" "dreams softly" "all is calm" "safe and sound" "undisturbed" "watches over you" "at peace" "serene" "breathes slowly")

peaceful_msg() {
  local n=$(( PEACE_IDX % ${#PEACE_MSGS[@]} ))
  PEACE_IDX=$(( PEACE_IDX + 1 ))
  echo "${PEACE_MSGS[$n]}"
}

# ─── Ghost reactions ───
ghost_react() {
  local state="$1"
  case "$state" in
    peace)
      local n=$(( PEACE_IDX % ${#PEACE_MSGS[@]} ))
      PEACE_IDX=$(( PEACE_IDX + 1 ))
      echo -e "  ${DIM}▝▜██▛▘${D}  ${DIM}${PEACE_MSGS[$n]}${D}"
      ;;
    pulled)    echo -e "  ${C}▝▜███▛▘${D}  ${C}↓ descended${D}" ;;
    pushed)    echo -e "  ${G}▝▜████▛▘${D}  ${G}↑ ascended${D}" ;;
    synced)    echo -e "  ${G}▝▜███▛▘${D}  ${G}✦ renewed${D}" ;;
    committed) echo -e "  ${W}▝▜███▛▘${D}  ${W}~ inscribed${D}" ;;
    guarded)   echo -e "  ${Y}▝▜████▛▘${D}  ${Y}⚔ protected${D}" ;;
    failed)    echo -e "  ${R}▝▜█▛▘${D}  ${R}✗ troubled${D}" ;;
    blocked)   echo -e "  ${Y}▝▜██▛▘${D}  ${Y}⚡ blocked${D}" ;;
    cloned)    echo -e "  ${C}▝▜█████▛▘${D}  ${C}+ born${D}" ;;
    force_pull) echo -e "  ${Y}▝▜███▛▘${D}  ${Y}↓ forced descent (remote newer)${D}" ;;
    force_push) echo -e "  ${Y}▝▜███▛▘${D}  ${Y}↑ forced ascent (local newer)${D}" ;;
  esac
}

ok()    { printf "${G}     ✦${D} %s\n" "$*"; }
warn()  { printf "${Y}     ⚡${D} %s\n" "$*"; }
err()   { printf "${R}     ✗${D} %s\n" "$*"; }
guard() { printf "${Y}     ⚔${D} %s\n" "$*"; }

# ─── Lock ───
acquire_lock() {
  if [ -f "$LOCKFILE" ]; then
    local pid; pid=$(cat "$LOCKFILE" 2>/dev/null || echo "")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      err "Heaven already running (PID $pid)"; exit 1
    fi
    rm -f "$LOCKFILE"
  fi
  echo $$ > "$LOCKFILE"
}

REPORT=$(mktemp 2>/dev/null || echo "$TMP/heaven_report_$$")
cleanup() { rm -f "$LOCKFILE" "$REPORT"; }
trap cleanup EXIT INT TERM

# ─── The Gate ───
gate() {
  echo ""
  echo -e "${DIM}        ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁${D}"
  echo ""
  echo -e "${DIM}                     ·  ${W}✦${DIM}  ·${D}"
  echo -e "${DIM}                ✧              ✧${D}"
  echo ""
  echo -e "${W}               H  E  A  V  E  N${D}"
  echo -e "${C}                  (Oracle AI Edition)${D}"
  echo -e "${DIM}                  Host: $OS${D}"
  echo ""
  echo -e "${DIM}                ✧              ✧${D}"
  echo -e "${DIM}                     ·  ${W}✦${DIM}  ·${D}"
  echo ""
  echo -e "${DIM}        ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁${D}"
  echo ""
  echo -e "               ${W}▐▛███▜▌${D}"
  echo -e "               ${W}▝▜█████▛▘${D}  ${DIM}Follow me${D}"
  echo ""
  if ! $PREVIEW; then
    echo -e "${DIM}           ⛩  Syncing the universe  ⛩${D}"
  else
    echo -e "${DIM}           ⛩  Preview · read only   ⛩${D}"
  fi
  echo ""
}

# ─── Repo header (ghost appears) ───
repo_header() {
  local name="$1" branch="$2"
  local total=50 used=$(( ${#name} + ${#branch} + 2 ))
  local dots=$(( total - used ))
  [ $dots -lt 3 ] && dots=3
  echo ""
  cloud
  echo ""
  printf "  ${W}▐▛█▜▌${D}  ${C}%s${D} ${DIM}%s${D} ${W}%s${D}\n" "$name" "$(printf '·%.0s' $(seq 1 $dots))" "$branch"
}

# ─── Smart add (blocks sensitive files) ───
smart_add() {
  local rp="$1"
  git -C "$rp" add -A || true
  local blocked
  blocked=$(git -C "$rp" diff --cached --name-only 2>/dev/null | grep -iE "$SENSITIVE" || true)
  if [ -n "$blocked" ]; then
    GHOST_STATE="guarded"
    while IFS= read -r f; do
      [ -n "$f" ] && git -C "$rp" reset HEAD -- "$f" 2>/dev/null && guard "blocked: $f"
    done <<< "$blocked"
  fi
}

# ─── Sync one repo ───
sync_repo() {
  local rp="$1"
  local name=$(basename "$rp")
  local branch=$(git -C "$rp" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
  GHOST_STATE="peace"

  [ "$branch" = "HEAD" ] && { repo_header "$name" "detached"; warn "detached HEAD · skip"; ghost_react "blocked"; echo "skip" >> "$REPORT"; return; }

  repo_header "$name" "$branch"

  # Fetch
  if ! git -C "$rp" fetch origin --prune 2>/dev/null; then
    err "fetch failed"; ghost_react "failed"; echo "fail" >> "$REPORT"; return
  fi

  # Divergence & "Le plus récent a raison"
  local lh rh bh
  lh=$(git -C "$rp" rev-parse "$branch" 2>/dev/null || echo "")
  rh=$(git -C "$rp" rev-parse "origin/$branch" 2>/dev/null || echo "")

  local resolved_divergence=false

  if [ -n "$lh" ] && [ -n "$rh" ] && [ "$lh" != "$rh" ]; then
    bh=$(git -C "$rp" merge-base "$branch" "origin/$branch" 2>/dev/null || echo "")
    if [ "$bh" != "$rh" ] && [ "$bh" != "$lh" ]; then
      local local_time=$(git -C "$rp" show -s --format=%ct "$lh" 2>/dev/null || echo 0)
      local remote_time=$(git -C "$rp" show -s --format=%ct "$rh" 2>/dev/null || echo 0)
      
      warn "diverged · applying 'most recent wins' miracle"
      
      if $USE_AI && ! $PREVIEW; then
         local conflict_diff=$(git -C "$rp" diff "$lh" "$rh" 2>/dev/null)
         local c_msg=$(oracle "Deux branches ont divergé. Voici la différence. Donne une seule phrase courte (max 12 mots) expliquant le conflit." "$conflict_diff")
         [ -n "$c_msg" ] && echo -e "       ${DIM}↳ Oracle: ${c_msg}${D}"
      fi

      if [ "$local_time" -gt "$remote_time" ]; then
        if $PREVIEW; then
          ok "would force push (local is newer)"
          GHOST_STATE="force_push"
        else
          if git -C "$rp" push --force-with-lease origin "$branch" 2>/dev/null || git -C "$rp" push --force origin "$branch" 2>/dev/null; then
            ok "↑ force pushed local changes (local wins)"
            GHOST_STATE="force_push"
            resolved_divergence=true
            rh="$lh" # Now they are the same
          else
            err "force push failed"
            ghost_react "failed"; echo "fail" >> "$REPORT"; return
          fi
        fi
      else
        if $PREVIEW; then
          ok "would hard reset to remote (remote is newer)"
          GHOST_STATE="force_pull"
        else
          if git -C "$rp" reset --hard "origin/$branch" >/dev/null 2>&1; then
            ok "↓ hard reset to remote (remote wins)"
            GHOST_STATE="force_pull"
            resolved_divergence=true
            lh="$rh" # Now they are the same
          else
            err "hard reset failed"
            ghost_react "failed"; echo "fail" >> "$REPORT"; return
          fi
        fi
      fi
    fi
  fi

  # Stash if dirty
  local stashed=false
  if ! git -C "$rp" diff --quiet 2>/dev/null || ! git -C "$rp" diff --cached --quiet 2>/dev/null; then
    stashed=true
    $PREVIEW || git -C "$rp" stash push -m "heaven-$(date +%s)" >/dev/null 2>&1 || true
  fi

  # Pull (if not already resolved by hard reset)
  if [ -n "$rh" ] && [ "$lh" != "$rh" ] && ! $resolved_divergence; then
    local behind=$(git -C "$rp" rev-list "$branch..origin/$branch" --count 2>/dev/null || echo "0")
    if [ "$behind" -gt 0 ]; then
      if $PREVIEW; then
        ok "would pull $behind commits"
        if [ "$GHOST_STATE" = "peace" ]; then GHOST_STATE="pulled"; fi
      else
        if ! git -C "$rp" pull --rebase origin "$branch" >/dev/null 2>&1; then
          git -C "$rp" rebase --abort >/dev/null 2>&1 || true
          if ! git -C "$rp" pull --no-rebase origin "$branch" >/dev/null 2>&1; then
            err "pull failed"
            $stashed && git -C "$rp" stash pop 2>/dev/null || true
            ghost_react "failed"; echo "fail" >> "$REPORT"; return
          fi
        fi
        ok "↓ pulled $behind"
        if [ "$GHOST_STATE" = "peace" ]; then GHOST_STATE="pulled"; fi
        
        # Pull Summary with Oracle
        if $USE_AI; then
           local pull_diff=$(git -C "$rp" log -p -n "$behind" 2>/dev/null)
           local summary=$(oracle "Résume très brièvement (1 ou 2 phrases claires) les nouveautés téléchargées à partir de ce log Git." "$pull_diff")
           if [ -n "$summary" ]; then
             echo -e "       ${DIM}↳ Changelog: ${summary}${D}"
           fi
        fi
      fi
    fi
  fi

  # Unstash
  if $stashed && ! $PREVIEW; then
    if ! git -C "$rp" stash pop >/dev/null 2>&1; then
      warn "unstash conflict · reseting stash changes to keep peace"
      git -C "$rp" reset --hard >/dev/null 2>&1 || true
    fi
  fi

  # Commit
  local has_changes=false
  git -C "$rp" diff --quiet 2>/dev/null && git -C "$rp" diff --cached --quiet 2>/dev/null || has_changes=true
  [ "$(git -C "$rp" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')" -gt 0 ] && has_changes=true

  if $has_changes; then
    if $PREVIEW; then
      ok "has local changes"
    else
      smart_add "$rp"
      local staged=$(git -C "$rp" diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ' || echo "0")
      if [ "$staged" -gt 0 ]; then
        local msg=""
        if $USE_AI; then
          # Pre-push / pre-commit check for subtleties not caught by regex
          local diff_str=$(git -C "$rp" diff --cached 2>/dev/null)
          
          # Smart Commit generation
          msg=$(oracle "Tu es un développeur expert. Génère un message de commit très court (1 ligne maximum, pas de point à la fin, pas de fioritures) et précis pour ces changements. Ne réponds QUE par le texte du message." "$diff_str")
          
          # Remove possible quotes around the generated message
          msg=$(echo "$msg" | sed 's/^"//;s/"$//')
        fi
        
        [ -z "$msg" ] && msg="heaven · ${staged} files · $(date +%Y-%m-%d)"
        
        if git -C "$rp" commit -m "$msg" >/dev/null 2>&1; then
          ok "committed: $msg"
          if [ "$GHOST_STATE" = "peace" ]; then GHOST_STATE="committed"; fi
        fi
      fi
    fi
  fi

  # Push
  local ahead=$(git -C "$rp" rev-list "origin/$branch..$branch" --count 2>/dev/null || echo "0")
  if [ "$ahead" -gt 0 ] && ! $resolved_divergence; then
    if $PREVIEW; then
      ok "would push $ahead commits"
      if [ "$GHOST_STATE" = "peace" ] || [ "$GHOST_STATE" = "committed" ]; then GHOST_STATE="pushed"; fi
    else
      if git -C "$rp" push origin "$branch" 2>/dev/null; then
        ok "↑ pushed $ahead"
        if [ "$GHOST_STATE" = "peace" ] || [ "$GHOST_STATE" = "committed" ]; then GHOST_STATE="pushed"; fi
      else
        warn "push rejected"
        GHOST_STATE="failed"
      fi
    fi
  fi

  # Build
  if ! $PREVIEW; then
    if [ -f "$rp/package.json" ]; then
      (cd "$rp" && npm install --silent >/dev/null 2>&1 && npm run build >/dev/null 2>&1) && ok "build OK" || warn "build"
    elif [ -f "$rp/requirements.txt" ] || [ -f "$rp/pyproject.toml" ]; then
      local py_ok=true
      while IFS= read -r -d '' pyfile; do
        $PY -m py_compile "$pyfile" 2>/dev/null || py_ok=false
      done < <(find "$rp" -name '*.py' -not -path '*/.venv/*' -not -path '*/__pycache__/*' -not -path '*/node_modules/*' -print0 2>/dev/null || true)
      $py_ok && ok "smoke OK" || warn "py_compile errors"
    elif [ -f "$rp/go.mod" ]; then
      (cd "$rp" && go build ./... 2>/dev/null) && ok "build OK" || warn "build"
    elif [ -f "$rp/Cargo.toml" ]; then
      (cd "$rp" && cargo check 2>/dev/null) && ok "check OK" || warn "check"
    fi
  fi

  # Deploy (host-aware)
  if [ -f "$rp/.kimea.conf" ]; then
    local dcmd dhost
    dcmd=$(grep -E '^KIMEA_DEPLOY_CMD=' "$rp/.kimea.conf" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d '"' | tr -d "'" || true)
    dhost=$(grep -E '^KIMEA_DEPLOY_HOST=' "$rp/.kimea.conf" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d '"' | tr -d "'" || true)
    if [ -n "$dcmd" ]; then
      local allowed=false
      for p in systemctl docker docker-compose pm2 supervisorctl nginx apache2ctl ssh; do
        [[ "$dcmd" == $p* ]] && allowed=true && break
      done
      if $allowed; then
        if $PREVIEW; then
          ok "would deploy: $dcmd"
        else
          # If deploy host specified and command not available locally → SSH
          if [ -n "$dhost" ] && ! command -v "${dcmd%% *}" >/dev/null 2>&1; then
            ssh -n "$dhost" "$dcmd" 2>/dev/null && ok "deployed via $dhost" || warn "deploy failed"
          else
            eval "$dcmd" 2>/dev/null && ok "deployed" || warn "deploy failed"
          fi
        fi
      else
        warn "deploy blocked (not whitelisted): $dcmd"
      fi
    fi
  fi

  # Ghost reacts
  if [ "$GHOST_STATE" = "peace" ]; then
    if $has_changes || [ "$ahead" -gt 0 ]; then
      GHOST_STATE="synced"
    fi
  fi
  ghost_react "$GHOST_STATE"
  echo "synced" >> "$REPORT"
}

# ─── Peace (the closing) ───
peace() {
  local synced; synced=$(grep -c "^synced$" "$REPORT" 2>/dev/null) || synced=0
  local cloned; cloned=$(grep -c "^cloned$" "$REPORT" 2>/dev/null) || cloned=0
  local failed; failed=$(grep -c "^fail$" "$REPORT" 2>/dev/null) || failed=0
  local blocked; blocked=$(grep -c "^blocked$" "$REPORT" 2>/dev/null) || blocked=0

  echo ""
  echo ""
  echo -e "${DIM}        ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁${D}"
  echo ""
  echo -e "${DIM}                  ·  ${W}✦${DIM}  ·  ${W}✦${DIM}  ·${D}"
  echo ""
  echo -e "          ${W}▐▛█████▜▌${D}  All souls at peace"
  echo -e "          ${W}▝▜███████▛▘${D}"
  echo ""
  echo -e "          ${G}✦${D} $synced synced  ${C}+${D} $cloned cloned  ${Y}⚡${D} $blocked blocked  ${R}✗${D} $failed failed"

  if $PREVIEW; then
    echo ""
    echo -e "          ${DIM}Preview · run ${W}heaven${DIM} to ascend${D}"
  fi

  echo ""
  echo -e "${DIM}                  ·  ${W}✦${DIM}  ·  ${W}✦${DIM}  ·${D}"
  echo ""
  echo -e "${DIM}        ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁  ☁${D}"
  echo ""
}

# ─── Main ───
acquire_lock
gate

PY=$(command -v python3 2>/dev/null || command -v python 2>/dev/null || echo "python3")

REPOS=$(gh repo list "$GH_USER" --json name,isArchived --limit 1000 2>/dev/null | $PY -c "
import json,sys
for r in json.load(sys.stdin):
    if not r.get('isArchived',False): print(r['name'])
" 2>/dev/null) || REPOS=""

if [ -z "$REPOS" ]; then
  REPOS=$(curl -sf "https://api.github.com/users/$GH_USER/repos?per_page=100" 2>/dev/null | $PY -c "
import json,sys
for r in json.load(sys.stdin):
    if not r.get('archived',False): print(r['name'])
" 2>/dev/null) || REPOS=""
fi

[ -z "$REPOS" ] && { err "Cannot list repos · check gh auth status"; exit 1; }

while IFS= read -r repo; do
  [ -z "$repo" ] && continue
  DEST="$BASE_DIR/$repo"

  if [ -d "$DEST/.git" ]; then
    sync_repo "$DEST" || true
  else
    echo ""
    cloud
    echo ""
    printf "  ${W}▐▛█▜▌${D}  ${C}%s${D}" "$repo"
    if $PREVIEW; then
      printf " ${DIM}· would clone${D}\n"
      ghost_react "peace"
    else
      printf " ${DIM}· cloning${D}\n"
      if git clone "git@github.com:$GH_USER/$repo.git" "$DEST" 2>/dev/null || \
         git clone "https://github.com/$GH_USER/$repo.git" "$DEST" 2>/dev/null; then
        ok "cloned"
        
        # Oracle README Generation
        if $USE_AI && [ ! -f "$DEST/README.md" ]; then
           local r_files=$(ls -1 "$DEST" 2>/dev/null)
           local r_content=$(oracle "Génère un README.md minimaliste mais professionnel pour le projet '$repo'. Ce projet contient ces fichiers initiaux : $r_files. Ne renvoie QUE le contenu Markdown sans commentaires." "Génère le README.")
           if [ -n "$r_content" ]; then
              echo "$r_content" > "$DEST/README.md"
              git -C "$DEST" add README.md >/dev/null 2>&1
              git -C "$DEST" commit -m "✨ Initialized README with Oracle AI" >/dev/null 2>&1
              git -C "$DEST" push origin main >/dev/null 2>&1 || git -C "$DEST" push origin master >/dev/null 2>&1 || true
              ok "Oracle crafted README"
           fi
        fi

        ghost_react "cloned"
      else
        err "clone failed"
        ghost_react "failed"
        echo "fail" >> "$REPORT"
        continue
      fi
    fi
    echo "cloned" >> "$REPORT"
  fi
done <<< "$REPOS"

peace